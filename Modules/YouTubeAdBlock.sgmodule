#!name=YouTube 视频广告拦截（iOS）
#!desc=独立模块：处理 YouTube 视频贴片、首页、搜索、推荐与 Shorts 广告。首次启用前须启用 HTTPS 解密并信任 Surge 证书；不修改主配置。
#!system=ios

# 基于 Maasea/sgmodule 当前维护的 YouTube iOS 响应与请求处理逻辑。
# 保持上传按钮、选段按钮与 Shorts 原样显示；不配置字幕翻译或调试模式。

[Script]
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,script-update-interval=86400,argument="{\"captionLang\":\"off\",\"blockUpload\":false,\"blockImmersive\":false,\"blockShorts\":false,\"debug\":false}"
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,script-update-interval=86400,argument="{\"captionLang\":\"off\"}"
youtube.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,script-update-interval=86400

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+[?&]oad= data-type=text data="" status-code=200

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
