#!name=网络诊断工具
#!desc=提供出口 IP、策略健康与网络信息的手动脚本入口。

[Script]
出口 IP 检查 = type=generic,script-path=https://raw.githubusercontent.com/Lin0323/surge-rules/main/Scripts/IPCheck.js,script-update-interval=86400
节点健康检查 = type=generic,script-path=https://raw.githubusercontent.com/Lin0323/surge-rules/main/Scripts/NodeHealth.js,script-update-interval=86400
网络信息 = type=generic,script-path=https://raw.githubusercontent.com/Lin0323/surge-rules/main/Scripts/NetworkInfo.js,script-update-interval=86400
